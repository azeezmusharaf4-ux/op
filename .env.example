# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Secret key for Paystack API (e.g. sk_test_... or sk_live_...) for server-side bank account verification, transactions, and charges. Keep on the server only.
PAYSTACK_SECRET_KEY=

# VITE_PAYSTACK_PUBLIC_KEY: Public key for Paystack Client-Side Popup Checkout (e.g. pk_test_... or pk_live_...) for direct Netlify/client top-ups.
VITE_PAYSTACK_PUBLIC_KEY=

# OPAY_API_KEY: Secure API key for incoming BNB Smart Chain website withdrawal transactions.
OPAY_API_KEY=opay_live_bsc_sec_98f4a27b1e83c

# OPAY_WEBHOOK_SECRET: Webhook secret for HMAC signature verification from BNB Smart Chain website.
OPAY_WEBHOOK_SECRET=opay_whsec_77b31d90e4f2a

# Real SMS Gateway Configurations (Termii, Twilio, Africa's Talking, Infobip)
# TERMII_API_KEY: Termii API Key for Nigerian SMS & OTP verification delivery (https://termii.com)
TERMII_API_KEY=
TERMII_SENDER_ID=OPay

# TWILIO_ACCOUNT_SID: Twilio Account SID for international/Nigerian SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AFRICASTALKING_API_KEY: Africa's Talking SMS API Key
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=OPay

# INFOBIP_API_KEY: Infobip SMS API Key & Base URL
INFOBIP_API_KEY=
INFOBIP_BASE_URL=

